{
  // Cloudflare Workers Builds 로 배포할 때 읽는 설정.
  // main 을 두지 않는 **정적 자산 전용 워커**다. dist 를 그대로 올린다.
  // ★Netlify 로 보낼 때는 netlify.toml 이 쓰이고 이 파일은 무시된다. 둘 다 둬도 서로 안 건드린다.
  // ★$schema 줄은 두지 않는다 — node_modules 를 설치하지 않는 저장소라 가리킬 파일이 없다.
  "name": "urbanoasis",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./dist",
    // 없는 주소는 dist/404.html 을 보여 준다. 그 쪽은 noindex 로 찍혀 있다.
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": true }
}
